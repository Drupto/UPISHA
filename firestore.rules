rules_version = '2';

// ---------------------------------------------------------------------------
// UP ISHA - Firestore Security Rules           (project: upisha)
// ---------------------------------------------------------------------------
// Hardened rules — the previous version contained a recursive wildcard
//   match /{document=**} { allow read: if true; }
// which made EVERY collection world-readable (members, users, contact
// messages, receipts, email logs, ...). That wildcard is gone; public reads
// are now granted per-collection, explicitly.
//
// Server-side access: the Next.js API layer uses the Firebase ADMIN SDK
// (src/lib/firebase-server.ts), which bypasses these rules entirely.
// Authorization for API requests is enforced in code (requireAuth /
// requireAdmin / requireVerifiedMember) — these rules protect the
// browser-facing client SDK surface.
//
// Collections that only the server writes (rate_limits, api_logs, emailLogs)
// are closed to clients completely.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helpers ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfEmail(email) {
      // Rules language has no .toLowerCase() — case conversion is the
      // zero-argument string method .lower() (not the global string.lower()).
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == email.lower();
    }

    // ============ Public site content (world-readable, admin-managed) ============
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryImages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publications/{pubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletterCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ Members ============
    // Docs are created by the SERVER (Admin SDK) via /api/join — the client
    // never creates them. Owners may edit their own profile fields but must
    // never change their own approval `status` (self-approval guard).
    match /members/{memberId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin() ||
        (isOwner(resource.data.uid) &&
         request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ============ Users (role records) ============
    // Written ONLY by the server (Admin SDK). An owner must never be able
    // to edit their own record — otherwise `role: 'admin'` self-grant.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    // ============ Contact messages ============
    // Created by the server (Admin SDK) via /api/contact; the email trigger
    // Cloud Function fires on create — client creates would be an email-bomb
    // vector, so the client surface is closed.
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ============ Teach requests ("Teach on UP ISHA" applications) ============
    // Created by the server (Admin SDK) via /api/teach-requests; reviewed by
    // admins in /admin/teach-requests who contact the applicant manually.
    // Client surface is closed to prevent spam writes.
    match /teachRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ============ Newsletter ============
    // Subscribed via /api/newsletter (server, Admin SDK). The welcome-email
    // trigger fires on create — client writes would be an email-bomb vector.
    match /newsletterSubscribers/{subId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============ Webinar registrations ============
    // Created by the server (Admin SDK) via /api/webinars/register.
    match /webinarRegistrations/{regId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ============ Publication submissions ============
    // Created by the server (Admin SDK) via /api/publications/submissions.
    // Readable by admins and by the submitting author (email match).
    match /publicationSubmissions/{subId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isSelfEmail(resource.data.authorEmail));
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // ============ Certificates & receipts (member-private) ============
    match /certificates/{certId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ============ Server-only collections (Admin SDK only) ============
    // Written by Cloud Functions (Brevo email logging) and by the Next.js
    // server (rate limiting, API audit logs) — clients get nothing.
    match /emailLogs/{logId} {
      allow read, write: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    match /api_logs/{logId} {
      allow read, write: if false;
    }

    // Admin action audit trail (src/lib/audit-log.ts). Server-only and
    // append-only — clients get nothing.
    match /admin_audit_logs/{logId} {
      allow read, write: if false;
    }

    // ============ Explicit deny-all fallback ============
    // Any collection not explicitly allowed above is closed. (Firestore
    // denies by default; this block documents that and guards against
    // accidentally re-introducing a permissive wildcard.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}