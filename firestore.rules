rules_version = '2';

// ---------------------------------------------------------------------------
// UP ISHA - Firestore Security Rules           (project: upisha)
// ---------------------------------------------------------------------------
// Hardened rules — the previous version contained a recursive wildcard
//   match /{document=**} { allow read: if true; }
// which made EVERY collection world-readable (members, users, contact
// messages, receipts, email logs, ...). That wildcard is gone; public reads
// are now granted per-collection, explicitly.
//
// Server-side access: the Next.js API layer uses the Firebase ADMIN SDK
// (src/lib/firebase-server.ts), which bypasses these rules entirely.
// Authorization for API requests is enforced in code (requireAuth /
// requireAdmin / requireVerifiedMember) — these rules protect the
// browser-facing client SDK surface.
//
// Collections that only the server writes (rate_limits, api_logs, emailLogs)
// are closed to clients completely.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helpers ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfEmail(email) {
      // Rules language has no .toLowerCase() — case conversion is the
      // zero-argument string method .lower() (not the global string.lower()).
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == email.lower();
    }

    // ============ Public site content (world-readable, admin-managed) ============
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryImages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publications/{pubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletterCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ Members (join form) ============
    match /members/{memberId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin() || isOwner(resource.data.uid);
      allow delete: if isAdmin();
    }

    // ============ Users (role records) ============
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }

    // ============ Contact messages ============
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============ Newsletter ============
    // Public upsert: create always; update only when the doc ID matches the
    // subscribed email (prevents overwriting other subscribers' data).
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow update: if request.resource.data.email == subId;
      allow read, delete: if isAdmin();
    }

    // ============ Webinar registrations ============
    match /webinarRegistrations/{regId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============ Publication submissions ============
    // Readable by admins and by the submitting author (email match).
    match /publicationSubmissions/{subId} {
      allow create: if true;
      allow read: if isAdmin() ||
        (isSignedIn() && isSelfEmail(resource.data.authorEmail));
      allow update, delete: if isAdmin();
    }

    // ============ Certificates & receipts (member-private) ============
    match /certificates/{certId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ============ Server-only collections (Admin SDK only) ============
    // Written by Cloud Functions (Brevo email logging) and by the Next.js
    // server (rate limiting, API audit logs) — clients get nothing.
    match /emailLogs/{logId} {
      allow read, write: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    match /api_logs/{logId} {
      allow read, write: if false;
    }

    // ============ Explicit deny-all fallback ============
    // Any collection not explicitly allowed above is closed. (Firestore
    // denies by default; this block documents that and guards against
    // accidentally re-introducing a permissive wildcard.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}