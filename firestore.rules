rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Members (join form)
    match /members/{memberId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin() || isOwner(resource.data.uid);
      allow delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Contact messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter subscribers
    // Public upsert: allow create always, and allow update only when the
    // document ID matches the email being subscribed (prevents overwriting
    // other subscribers' data). Read/delete remain admin-only.
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow update: if request.resource.data.email == subId;
      allow read, delete: if isAdmin();
    }

    // Newsletter campaigns
    match /newsletterCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Webinars
    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Webinar registrations
    match /webinarRegistrations/{regId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Announcements, Events, Testimonials, Gallery, Publications
    match /{document=**} {
      allow read: if true;
    }

    match /announcements/{docId} {
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow write: if isAdmin();
    }

    match /galleryImages/{docId} {
      allow write: if isAdmin();
    }

    match /publications/{pubId} {
      allow write: if isAdmin();
    }

    // Publication submissions
    match /publicationSubmissions/{subId} {
      allow create: if true;
      allow read: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if isAdmin() || resource.data.memberUid == request.auth.uid;
      allow write: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Receipts
    match /receipts/{receiptId} {
      allow read: if isAdmin() || resource.data.memberUid == request.auth.uid;
      allow write: if isAdmin();
    }

    // Email logs (written by Cloud Functions only)
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}