# ─── Site Configuration ───
NEXT_PUBLIC_SITE_URL=https://upisha.org

# ─── Brevo Email Configuration (for Firebase Cloud Functions) ───
# These are used by the Next.js app if you want direct Brevo integration.
# The primary email sending happens in Firebase Cloud Functions (functions/ directory).
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@upisha.org
BREVO_SENDER_NAME=UP ISHA Team

# ─── SEO Verification ───
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ─── Google Analytics 4 ───
NEXT_PUBLIC_GA_ID=

# ─── Client-side Firebase config (used for both client and server) ───
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─── Server-side Firebase Admin SDK (SERVER ONLY — never expose to the browser) ───
# Used by src/lib/firebase-server.ts for privileged server work (token
# verification with revocation, Firestore/Storage writes that must not be
# evaluated against security rules).
#
# Extract these three values from the service-account JSON key you download
# from GCP Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON.
#
# IMPORTANT — private key format:
#   Copy the private_key value EXACTLY as it appears in the JSON file:
#   a single line, keeping the literal \n escape sequences, WITHOUT the
#   surrounding quotes. Do NOT decode the \n into real newlines.
#   (The code tolerates both variants, but the escaped form is safest.)
#
# IMPORTANT — naming:
#   NEVER prefix these with NEXT_PUBLIC_ — that would bundle the private
#   key into the browser bundle and leak it publicly.
#
# In Netlify, set these as Production + Deploy-preview env vars and mark
# the private key value as a secret (masked in logs/dashboard).
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...your-key-content...\n-----END PRIVATE KEY-----\n
# Optional: explicit Storage bucket name. Defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
# FIREBASE_ADMIN_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ─── Admin authorization ───
# Admin access is controlled via the Firestore `users` collection `role` field.
# To grant a user admin access, set their document in Firestore `users/{uid}`
# to { role: "admin" }. No env var is needed.